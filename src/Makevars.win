## C++ standard: do NOT pin this.
##
## This used to say `CXX_STD = CXX11`.  Modern RcppArmadillo needs C++14 or
## later -- pinning C++11 fails to compile with
##     armadillo_bits/fn_accu.hpp: note: deduced return type only available
##     with '-std=c++14' or '-std=gnu++14'
## and RcppArmadillo itself warns to remove the directive ("Using fallback
## compilation with Armadillo 14.6.3 ... consider removing C++11 compilation
## directive").  On some machines the fallback hides the problem; on Great Lakes
## with R 4.5.1 it does not, and the build dies.
##
## R 4.3 and later default to C++17, which is what both Armadillo and OpenMP
## want, so leaving this unset is correct and portable.
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) 
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
